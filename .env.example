# Copy this file to .env (gitignored) for local dev.
# These values flow into both `npm run build-config` (build-time, picks the
# active config YAML to compile into config.json) and `npm start` (runtime,
# provides MongoDB URI + port without needing shell env-var prefixes).

# Build-time: which YAML in configs/ should be compiled into config.json.
# Both `npm run build-config` (local) and `./deploy.sh` (production) read this.
ACTIVE_CONFIG=pilot_E.yaml

# Runtime (local dev only): MongoDB connection string.
# In production (Cloud Run), MONGODB_URI is injected from Secret Manager and
# takes precedence — dotenv does not overwrite preset env vars.
MONGODB_URI=mongodb://localhost:27017/AMGDB

# Runtime (local dev only): port to listen on.
# In production, Cloud Run sets PORT itself; this value is ignored there.
PORT=8080

# Runtime (optional): URL prefix the game is served under, e.g. /ver2_2026_11_05.
# Unset means the domain root. Production gets it from deploy.sh, not from .env
# (.env is excluded from the image by .dockerignore).
# BASE_PATH=/ver2_2026_11_05
